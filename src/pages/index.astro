---
import Base from '../layouts/Base.astro';
import { content, listings, CALENDLY } from '../data/content.js';

const forSale = listings.for_sale;
const candidates = listings.new_candidates;

const fmt = (n) => n.toLocaleString('en-US');

const { hero, approach, land, candidates: cand, why, involved, footerNote } = content;
---

<Base>
  <!-- ======================= HEADER ======================= -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top" aria-label="Liminal Forests Alliance home">
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 10 C17 24 17 44 32 56 C47 44 47 24 32 10 Z" fill="currentColor"/>
          <path d="M32 16 L32 50" stroke="#143d2f" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M32 26 L24 21 M32 34 L41 28 M32 42 L24 37" stroke="#143d2f" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        <span>Liminal Forests Alliance</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#approach">Approach</a>
        <a href="#land">Land for sale</a>
        <a href="#why">Why it matters</a>
        <a href="#involved" class="nav-cta">Get involved</a>
      </nav>
    </div>
  </header>

  <!-- ======================= HERO ======================= -->
  <section id="top" class="hero">
    <div class="hero-bg" aria-hidden="true">
      <svg viewBox="0 0 1440 700" preserveAspectRatio="xMidYMax slice">
        <defs>
          <linearGradient id="hsky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0c2219"/>
            <stop offset="0.6" stop-color="#143d2f"/>
            <stop offset="1" stop-color="#0a1f17"/>
          </linearGradient>
        </defs>
        <rect width="1440" height="700" fill="url(#hsky)"/>
        <circle cx="1140" cy="150" r="70" fill="#f4f1e8" opacity="0.10"/>
        <path d="M0 500 L180 450 L340 490 L520 440 L700 485 L880 435 L1060 480 L1240 440 L1440 480 L1440 700 L0 700 Z" fill="#1c5240" opacity="0.5"/>
        <path d="M0 560 L200 515 L400 550 L620 510 L820 548 L1020 508 L1220 548 L1440 515 L1440 700 L0 700 Z" fill="#103026" opacity="0.8"/>
        <path d="M0 620 L240 585 L480 615 L720 580 L960 615 L1200 582 L1440 612 L1440 700 L0 700 Z" fill="#0a1f17"/>
      </svg>
    </div>
    <div class="wrap hero-inner">
      <p class="eyebrow hero-eyebrow">{hero.eyebrow}</p>
      <h1>{hero.h1Lines[0]}<br />{hero.h1Lines[1]}</h1>
      <p class="hero-lede">{hero.lede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn-ghost" href={hero.ghostCta.href}>{hero.ghostCta.label}</a>
      </div>
    </div>
  </section>

  <!-- ======================= APPROACH ======================= -->
  <section id="approach" class="approach">
    <div class="wrap">
      <p class="eyebrow">{approach.eyebrow}</p>
      <h2 class="section-title">{approach.title}</h2>
      <p class="lede">{approach.lede}</p>

      <ol class="steps">
        {approach.steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ======================= LAND FOR SALE ======================= -->
  <section id="land" class="land">
    <div class="wrap">
      <p class="eyebrow">{land.eyebrow}</p>
      <h2 class="section-title">{land.title}</h2>
      <p class="lede">{land.lede}</p>

      <div class="grid">
        {forSale.map((p) => (
          <article class="card">
            <div class="card-top">
              <span class="chip">{p.country}</span>
              <span class="card-price">{p.price}{p.price_note && <small>{p.price_note}</small>}</span>
            </div>
            <h3 class="card-title">{p.name}</h3>
            <p class="card-loc">{p.location}</p>
            <dl class="card-meta">
              <div><dt>Area</dt><dd>{fmt(p.size_ha)} ha · {fmt(p.size_acres)} ac</dd></div>
              <div><dt>Broker</dt><dd>{p.broker}</dd></div>
            </dl>
            <a class="card-link" href={p.url} target="_blank" rel="noopener noreferrer">
              View listing
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8"/></svg>
            </a>
          </article>
        ))}
      </div>

      <div class="candidates">
        <p class="eyebrow">{cand.eyebrow}</p>
        <h2 class="section-title">{cand.title}</h2>
        <p class="lede">{cand.lede}</p>

        <div class="grid">
          {candidates.map((p) => (
            <article class="card card--candidate">
              <div class="card-top">
                <span class="chip chip--alt">{p.country}</span>
                <span class="card-price">{p.price}{p.price_note && <small>{p.price_note}</small>}</span>
              </div>
              <h3 class="card-title">{p.name}</h3>
              <p class="card-loc">{p.location}</p>
              {p.ecological_case && <p class="card-eco">{p.ecological_case}</p>}
              <dl class="card-meta">
                <div><dt>Area</dt><dd>{fmt(p.size_ha)} ha · {fmt(p.size_acres)} ac</dd></div>
                <div><dt>Broker</dt><dd>{p.broker}</dd></div>
              </dl>
              <a class="card-link" href={p.url} target="_blank" rel="noopener noreferrer">
                View listing
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8"/></svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= WHY IT MATTERS ======================= -->
  <section id="why" class="why">
    <div class="wrap why-inner">
      <div class="why-text">
        <p class="eyebrow">{why.eyebrow}</p>
        <h2 class="section-title">{why.title}</h2>
        <p class="lede">{why.lede}</p>
        <p class="why-para">{why.para}</p>
        <ul class="why-points">
          {why.points.map((pt) => (
            <li><strong>{pt.strong}</strong>{pt.rest}</li>
          ))}
        </ul>
      </div>
      <div class="why-aside" aria-hidden="true">
        <svg viewBox="0 0 400 480" class="why-art">
          <defs>
            <linearGradient id="wg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1c5240"/>
              <stop offset="1" stop-color="#0c2219"/>
            </linearGradient>
          </defs>
          <rect width="400" height="480" rx="20" fill="url(#wg)"/>
          <circle cx="300" cy="90" r="46" fill="#f4f1e8" opacity="0.12"/>
          <path d="M0 330 L90 300 L180 325 L270 295 L360 322 L400 305 L400 480 L0 480 Z" fill="#2a6b52" opacity="0.5"/>
          <path d="M0 375 L100 348 L200 372 L300 345 L400 370 L400 480 L0 480 Z" fill="#103026" opacity="0.85"/>
          <g stroke="#cfe6cd" stroke-width="2" opacity="0.85" fill="none">
            <path d="M200 430 L200 250"/>
            <path d="M200 300 C170 285 158 258 160 232 M200 300 C230 285 242 258 240 232"/>
            <path d="M200 345 C165 330 150 300 150 272 M200 345 C235 330 250 300 250 272"/>
          </g>
          <circle cx="200" cy="232" r="30" fill="#cfe6cd" opacity="0.9"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- ======================= GET INVOLVED ======================= -->
  <section id="involved" class="involved">
    <div class="wrap involved-inner">
      <p class="eyebrow eyebrow--light">{involved.eyebrow}</p>
      <h2 class="section-title">{involved.title}</h2>
      <p class="involved-lede">{involved.lede}</p>
      <div class="involved-actions">
        <a class="btn btn-primary" href={involved.primaryCta.href} target="_blank" rel="noopener noreferrer">{involved.primaryCta.label}</a>
        <a class="btn btn-ghost" href={involved.ghostCta.href}>{involved.ghostCta.label}</a>
      </div>
    </div>
  </section>

  <!-- ======================= FOOTER ======================= -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 10 C17 24 17 44 32 56 C47 44 47 24 32 10 Z" fill="currentColor"/>
          <path d="M32 16 L32 50" stroke="#0c2219" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M32 26 L24 21 M32 34 L41 28 M32 42 L24 37" stroke="#0c2219" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        <div>
          <strong>Liminal Forests Alliance</strong>
          <span>Part of Liminal Commons · Anthrōpico</span>
        </div>
      </div>
      <p class="footer-note">{footerNote}</p>
    </div>
  </footer>
</Base>

<style>
  /* ---------- header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(246, 243, 234, 0.82);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 68px; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.05rem; color: var(--forest-700); }
  .brand-mark { width: 26px; height: 26px; color: var(--forest-600); flex: none; }
  .site-nav { display: flex; align-items: center; gap: clamp(0.8rem, 2.5vw, 1.8rem); }
  .site-nav a { text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--ink-soft); }
  .site-nav a:hover { color: var(--forest-700); }
  .nav-cta { color: var(--forest-700) !important; font-weight: 600 !important; }
  @media (max-width: 680px) {
    .site-nav a:not(.nav-cta) { display: none; }
  }

  /* ---------- hero ---------- */
  .hero { position: relative; color: var(--paper); padding-block: clamp(90px, 16vw, 170px); overflow: hidden; isolation: isolate; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg svg { width: 100%; height: 100%; }
  .hero-inner { position: relative; }
  .hero-eyebrow { color: var(--sage-300); }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 5rem); color: var(--paper); font-weight: 500; }
  .hero-lede { margin-top: 1.5rem; font-size: clamp(1.1rem, 2.4vw, 1.4rem); color: #dfe9df; max-width: 56ch; line-height: 1.55; }
  .hero-actions { margin-top: 2.4rem; display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* ---------- shared section bits ---------- */
  .section-title { font-size: clamp(1.9rem, 4.5vw, 3rem); margin-bottom: 1rem; max-width: 20ch; }

  /* ---------- approach ---------- */
  .approach { background: var(--paper); }
  .steps { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .step { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.6rem; box-shadow: var(--shadow); }
  .step-n { font-family: 'Fraunces', serif; font-size: 1.1rem; color: var(--sage-300); background: var(--forest-700); width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border-radius: 50%; margin-bottom: 1rem; }
  .step h3 { font-size: 1.25rem; margin-bottom: 0.4rem; }
  .step p { margin: 0; color: var(--ink-soft); font-size: 0.97rem; }

  /* ---------- land / cards ---------- */
  .land { background: var(--paper-2); }
  .grid { margin-top: 2.6rem; display: grid; gap: 1.3rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; display: flex; flex-direction: column; box-shadow: var(--shadow); transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 1px 2px rgba(12,34,25,0.06), 0 22px 44px -22px rgba(12,34,25,0.35); }
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; }
  .chip { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--forest-600); background: #e8f0e6; border: 1px solid #d5e4d3; padding: 0.3rem 0.65rem; border-radius: 100px; white-space: nowrap; }
  .chip--alt { color: var(--gold); background: #f6edd9; border-color: #ecdcbb; }
  .card-price { text-align: right; font-weight: 600; font-size: 1.02rem; color: var(--forest-700); line-height: 1.25; }
  .card-price small { display: block; font-weight: 500; font-size: 0.78rem; color: var(--ink-soft); }
  .card-title { font-size: 1.22rem; font-weight: 500; margin-bottom: 0.35rem; }
  .card-loc { margin: 0 0 1rem; color: var(--ink-soft); font-size: 0.92rem; }
  .card-eco { margin: 0 0 1.1rem; font-size: 0.93rem; color: var(--ink); background: #f3f6f1; border-left: 3px solid var(--sage-300); padding: 0.7rem 0.85rem; border-radius: 0 8px 8px 0; }
  .card-meta { margin: 0 0 1.3rem; display: grid; gap: 0.6rem; }
  .card-meta div { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px dashed var(--line); padding-top: 0.55rem; }
  .card-meta dt { color: var(--ink-soft); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; margin: 0; }
  .card-meta dd { margin: 0; font-size: 0.9rem; font-weight: 500; text-align: right; }
  .card-link { margin-top: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: 0.95rem; color: var(--forest-700); text-decoration: none; }
  .card-link:hover { color: var(--forest-500); }
  .card-link svg { transition: transform 0.18s ease; }
  .card-link:hover svg { transform: translate(2px, -2px); }
  .candidates { margin-top: clamp(64px, 9vw, 110px); }

  /* ---------- why ---------- */
  .why { background: var(--paper); }
  .why-inner { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .why-para { color: var(--ink-soft); max-width: 60ch; }
  .why-points { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .why-points li { padding-left: 1.6rem; position: relative; color: var(--ink-soft); max-width: 58ch; }
  .why-points li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--sage-300); }
  .why-points strong { color: var(--ink); }
  .why-aside { align-self: stretch; }
  .why-art { width: 100%; height: 100%; border-radius: 20px; box-shadow: var(--shadow); }
  @media (max-width: 820px) { .why-inner { grid-template-columns: 1fr; } .why-aside { order: -1; max-width: 420px; } }

  /* ---------- involved ---------- */
  .involved { background: var(--forest-700); color: var(--paper); text-align: center; }
  .involved-inner { max-width: 680px; margin-inline: auto; }
  .involved .section-title { color: var(--paper); margin-inline: auto; }
  .eyebrow--light { color: var(--sage-300); }
  .involved-lede { margin: 0 auto 2rem; color: #dfe9df; font-size: clamp(1.05rem, 2.4vw, 1.25rem); max-width: 54ch; }
  .involved-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; }

  /* ---------- footer ---------- */
  .site-footer { background: var(--forest-900); color: #bcd0c2; padding-block: 3.5rem; }
  .footer-inner { display: grid; gap: 1.5rem; }
  .footer-brand { display: flex; align-items: center; gap: 0.7rem; }
  .footer-brand .brand-mark { width: 34px; height: 34px; color: var(--sage-200); }
  .footer-brand strong { display: block; color: var(--paper); font-family: 'Fraunces', serif; font-weight: 600; }
  .footer-brand span { font-size: 0.85rem; }
  .footer-note { margin: 0; font-size: 0.85rem; max-width: 70ch; line-height: 1.6; opacity: 0.85; }
</style>
