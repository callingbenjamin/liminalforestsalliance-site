---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stakes from '../components/Stakes.astro';
import Approach from '../components/Approach.astro';
import Ways from '../components/Ways.astro';
import Finale from '../components/Finale.astro';
import Footer from '../components/Footer.astro';
import { media } from '../data/media.js';
---

<Base preloadImage={media.hero?.poster}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Stakes />
    <Approach />
    <Ways />
    <Finale />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/main.js';
</script>
