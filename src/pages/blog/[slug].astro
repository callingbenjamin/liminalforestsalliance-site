---
import Blog from '../../layouts/Blog.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Photos from '../../components/Photos.astro';
import { posts, postUrl, postPath, isSalePost, getPost } from '../../data/blog.js';
import { SITE_URL } from '../../data/content.js';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const fmt = (n) => n.toLocaleString('en-US');

// Land-sale dispatches carry a "Property at a glance" box built from their
// sale fields; other stories may give their own short `glance` list.
const facts = isSalePost(post)
  ? [
      ['Location', post.location],
      ['Size', `${fmt(post.size_ha)} ha · ${fmt(post.size_acres)} ac`],
      ['Sale price', post.price],
      ['Sale date', post.saleDate],
      ['Seller', post.seller],
      ['Buyer', post.buyer],
      ['Current use', post.currentUse],
      ['Outcome', post.outcome],
    ]
  : post.glance ?? null;
// Series: a hub post lists `series` (child slugs); each child names its hub
// in `partOf` and links to its siblings at the end.
const series = (post.series ?? []).map(getPost).filter(Boolean);
const parent = post.partOf ? getPost(post.partOf) : null;
const siblings = parent ? (parent.series ?? []).filter((x) => x !== post.slug).map(getPost).filter(Boolean) : [];
const cover = post.cover ?? post.photos?.[0];
const chipAlt = post.outcome === 'Cautionary tale';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${postUrl(post.slug)}#article`,
  headline: post.title,
  description: post.summary,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: 'en',
  url: postUrl(post.slug),
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl(post.slug) },
  author: {
    '@type': 'Organization',
    name: 'Liminal Forests Alliance',
    url: `${SITE_URL}/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Liminal Forests Alliance',
    url: `${SITE_URL}/`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
  },
  isPartOf: { '@type': 'Blog', '@id': `${SITE_URL}/blog#blog`, name: 'Dispatches' },
  image: cover ? `${SITE_URL}${cover.src}-1200.webp` : `${SITE_URL}/og.png`,
};
---

<Blog
  title={`${post.title} — Liminal Forests Alliance`}
  description={post.summary}
  ogType="article"
  publishedTime={post.date}
  jsonLd={jsonLd}
  current="blog"
>
  <article class="post">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog">Dispatches</a>
        <span aria-hidden="true">/</span>
        <span>{post.region}</span>
      </nav>

      <header class="post-header">
        <div class="post-tags">
          <span class={`chip ${chipAlt ? 'chip--alt' : ''}`}>{post.outcome}</span>
          <time datetime={post.date}>Published {post.date}</time>
        </div>
        <h1>{post.title}</h1>
        <p class="post-loc">{post.location}</p>
        {parent && (
          <p class="part-of">Part of the series <a href={postPath(parent.slug)}>{parent.title}</a></p>
        )}
        <p class="lead">{post.lead}</p>
      </header>

      {post.photos && <Photos photos={post.photos} eager />}

      {facts && (
        <aside class="facts" aria-label={isSalePost(post) ? 'Property at a glance' : 'At a glance'}>
          <h2>{isSalePost(post) ? 'Property at a glance' : 'At a glance'}</h2>
          <dl>
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </aside>
      )}

      {post.intro && (
        <div class="prose prose--intro">
          {post.intro.map((para) => <p>{para}</p>)}
        </div>
      )}

      {series.length > 0 && (
        <section class="series" aria-labelledby="series-h">
          <h2 id="series-h">{post.seriesHeading ?? 'The stories'}</h2>
          <ol class="series-list">
            {series.map((p) => (
              <li>
                <a href={postPath(p.slug)}>
                  {p.cover && (
                    <img
                      src={`${p.cover.src}-800.webp`}
                      width={p.cover.width}
                      height={p.cover.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      style={p.cover.focus ? `object-position: ${p.cover.focus}` : undefined}
                    />
                  )}
                  <span class="series-text">
                    <strong>{p.title}</strong>
                    <span class="series-loc">{p.location}</span>
                    <span class="series-sum">{p.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      <div class:list={['prose', series.length > 0 && 'prose--closing']}>
        {post.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.paras.map((para) => <p>{para}</p>)}
            {s.photos && <Photos photos={s.photos} />}
            {s.beforeAfter && <BeforeAfter {...s.beforeAfter} />}
            {s.note && <p class="note">{s.note}</p>}
          </section>
        ))}
      </div>

      <section class="sources">
        <h2>{post.sourcesHeading ?? 'Sources'}</h2>
        <ol>
          {post.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a></li>
          ))}
        </ol>
      </section>

      <p class="dateline">
        The facts in this post are drawn from the cited sources and were accurate as of November 2026.
        A plain-text version is available at <a href={`/blog/${post.slug}.md`}>/blog/{post.slug}.md</a>.
      </p>

      {parent && siblings.length > 0 && (
        <nav class="more" aria-labelledby="more-h">
          <h2 id="more-h">More in this series</h2>
          <ul>
            {siblings.map((p) => <li><a href={postPath(p.slug)}>{p.title}</a></li>)}
          </ul>
          <p><a href={postPath(parent.slug)}>All the stories, and what keeps a planted forest standing</a></p>
        </nav>
      )}

      <p class="back"><a href="/blog">Back to all dispatches</a></p>
    </div>
  </article>
</Blog>

<style>
  .post { padding-block: clamp(3rem, 7vh, 5rem) clamp(4rem, 10vh, 6.5rem); }
  .post .wrap { max-width: 760px; }
  .crumbs { display: flex; gap: 0.5rem; align-items: center; font-family: var(--f-mono); font-size: 0.8rem; color: var(--text-3); margin-bottom: 1.8rem; }
  .crumbs a { color: var(--sun-soft); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .post-header h1 { font-family: var(--f-display); font-weight: 340; font-size: clamp(2.2rem, 5.2vw, 3.4rem); line-height: 1.08; margin-bottom: 0.7rem; }
  .post-tags { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.1rem; }
  .post-tags time { font-family: var(--f-mono); font-size: 0.8rem; color: var(--text-3); }
  .chip { font-family: var(--f-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--moss); border: 1px solid var(--line-2); padding: 0.28rem 0.6rem; border-radius: 999px; white-space: nowrap; }
  .chip--alt { color: var(--sun-soft); border-color: rgba(217, 165, 91, 0.45); }
  .post-loc { margin: 0 0 1.5rem; color: var(--text-3); font-family: var(--f-mono); font-size: 0.85rem; }
  .lead { font-size: var(--t-lede); line-height: 1.55; color: var(--text-1); margin: 0; }

  .facts { background: var(--night-2); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem 1.7rem; margin: 2.6rem 0; }
  .facts h2 { font-family: var(--f-mono); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sun); margin-bottom: 1.1rem; }
  .facts dl { margin: 0; display: grid; gap: 0; }
  .facts dl > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; border-top: 1px solid var(--line); padding-block: 0.7rem; }
  .facts dl > div:first-child { border-top: none; padding-top: 0; }
  .facts dt { color: var(--text-3); font-family: var(--f-mono); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.04em; margin: 0; }
  .facts dd { margin: 0; font-size: 0.94rem; color: var(--text-1); }
  @media (max-width: 560px) { .facts dl > div { grid-template-columns: 1fr; gap: 0.2rem; } }

  .prose--intro { margin-top: 2rem; }

  .part-of { margin: -0.6rem 0 1.5rem; font-size: 0.9rem; color: var(--text-3); }
  .part-of a { color: var(--sun-soft); }

  /* ---------- series hub: list of stories ---------- */
  .series { margin-top: 2.8rem; }
  .series > h2 { font-family: var(--f-display); font-weight: 350; font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 1.2rem; letter-spacing: -0.015em; }
  .series-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .series-list a { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.1rem; align-items: start; text-decoration: none; color: inherit; background: var(--night-2); border: 1px solid var(--line); border-radius: 12px; padding: 0.8rem; transition: border-color 0.25s; }
  .series-list a:hover { border-color: var(--line-2); }
  .series-list a:hover strong { color: var(--sun-soft); }
  .series-list img { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; border-radius: 8px; display: block; }
  .series-text { display: grid; gap: 0.3rem; padding-top: 0.15rem; }
  .series-text strong { font-family: var(--f-display); font-weight: 400; font-size: 1.22rem; line-height: 1.2; color: var(--text-1); }
  .series-loc { font-family: var(--f-mono); font-size: 0.72rem; color: var(--text-3); }
  .series-sum { font-size: 0.9rem; line-height: 1.5; color: var(--text-2); }
  @media (max-width: 560px) { .series-list a { grid-template-columns: 6.5rem 1fr; gap: 0.8rem; } .series-sum { display: none; } }

  .note { font-size: 0.85rem !important; line-height: 1.55 !important; color: var(--text-3) !important; font-style: italic; }

  .more { margin-top: 2.6rem; border-top: 1px solid var(--line); padding-top: 1.6rem; }
  .more h2 { font-family: var(--f-display); font-weight: 350; font-size: 1.4rem; margin-bottom: 0.8rem; }
  .more ul { margin: 0 0 1rem; padding-left: 1.2rem; display: grid; gap: 0.45rem; color: var(--text-3); }
  .more a { color: var(--sun-soft); }
  .more a:hover { color: var(--sun); }

  .prose--closing { margin-top: clamp(3.2rem, 8vh, 4.6rem); padding-top: 0.6rem; border-top: 1px solid var(--line); }

  .prose section { margin-top: 2.4rem; }
  .prose h2 { font-family: var(--f-display); font-weight: 350; font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.9rem; letter-spacing: -0.015em; }
  .prose p { color: var(--text-2); line-height: 1.75; margin: 0 0 1.1rem; max-width: 66ch; }

  .sources { margin-top: 2.8rem; border-top: 1px solid var(--line); padding-top: 1.8rem; }
  .sources h2 { font-family: var(--f-display); font-weight: 350; font-size: 1.4rem; margin-bottom: 0.9rem; }
  .sources ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.55rem; color: var(--text-3); }
  .sources a { color: var(--sun-soft); word-break: break-word; }
  .sources a:hover { color: var(--sun); }

  .dateline { margin-top: 2.2rem; font-size: 0.85rem; line-height: 1.6; color: var(--text-2); background: var(--night-2); border-left: 2px solid var(--sun); padding: 0.9rem 1.1rem; border-radius: 0 8px 8px 0; }
  .dateline a { color: var(--sun-soft); }
  .back { margin-top: 2.2rem; }
  .back a { color: var(--sun-soft); font-weight: 600; text-decoration: none; }
  .back a:hover { text-decoration: underline; }
</style>
