---
// Shared chrome for the blog ("Dispatches") and /listings: the site header
// (the same component as the home page, solid from the start) and a footer
// styled to match the site's dark, documentary theme. Wraps Base.astro (which
// owns <head>, canonical, the Markdown alternate, the RSS link and the JSON-LD)
// and passes SEO props straight through.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import { CALENDLY } from '../data/content.js';

const {
  title,
  description,
  ogType = 'website',
  publishedTime = null,
  jsonLd = null,
  // Which primary nav item to mark as current: 'blog' | 'listings' | null.
  current = null,
} = Astro.props;
---

<Base {title} {description} {ogType} {publishedTime} {jsonLd}>
  <Header page={current} />

  <main id="main" class="blog-main" tabindex="-1">
    <slot />
  </main>

  <footer class="bftr">
    <div class="wrap bftr-inner">
      <div class="bftr-brand">
        <img
          class="bftr-mark"
          src="/brand/mark-192.webp"
          srcset="/brand/mark-192.webp 192w, /brand/mark-320.webp 320w"
          sizes="64px"
          width="64"
          height="67"
          loading="lazy"
          decoding="async"
          alt=""
        />
        <p><strong>Liminal Forests <span>Alliance</span></strong></p>
      </div>
      <nav class="bftr-links" aria-label="Footer">
        <a href="/">Home</a>
        <a href="/listings">Old Growth</a>
        <a href="/rewilding">Rewilding</a>
        <a href="/blog">Dispatches</a>
        <a href="/blog.md">This blog as plain text</a>
        <a href="/blog/rss.xml">RSS feed</a>
        <a href="/listings">Old Growth</a>
      </nav>
      <p class="bftr-note">
        Dispatches are short, sourced stories about large wild land that has changed hands. Every fact is drawn from the cited sources and was accurate as of November 2026; confirm current details with the original sources. This site permits search and answer crawlers but does not permit AI-training crawlers.
      </p>
    </div>
  </footer>
</Base>

<script>
  import { initHeader } from '../scripts/header.js';

  const header = initHeader({ reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches });
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header.updateProgress();
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  header.updateProgress();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .blog-main { background: var(--night); color: var(--text-1); min-height: 60vh; }

  /* ---------- footer ---------- */
  .bftr { background: var(--night-2); border-top: 1px solid var(--line); padding-block: clamp(3rem, 7vh, 4.5rem); color: var(--text-2); }
  .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--gutter); }
  .bftr-inner { display: grid; grid-template-columns: auto 1fr; gap: 1.6rem 3rem; align-items: start; }
  .bftr-brand { display: flex; align-items: center; gap: 0.9rem; }
  .bftr-mark { width: 64px; height: auto; }
  .bftr-brand strong { font-family: var(--f-brand); font-weight: 720; font-size: 1.15rem; letter-spacing: -0.025em; color: var(--text-1); }
  .bftr-brand strong span { font-weight: 420; opacity: 0.72; }
  .bftr-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; justify-self: end; }
  .bftr-links a { color: var(--text-2); text-decoration: none; font-size: 0.9rem; }
  .bftr-links a:hover { color: var(--sun-soft); }
  .bftr-note { grid-column: 1 / -1; margin: 0; font-size: 0.8rem; line-height: 1.6; color: var(--text-3); max-width: 90ch; border-top: 1px solid var(--line); padding-top: 1.4rem; }
  @media (max-width: 720px) {
    .bftr-inner { grid-template-columns: 1fr; }
    .bftr-links { justify-self: start; }
  }
</style>
