---
import { content, CALENDLY } from '../data/content.js';
import { media } from '../data/media.js';

const { ways, about } = content;
const photos = media.ways || [];
const hasAbout = about.people.length > 0 || about.email || about.body;
---

<section id="involved" class="ways" data-section="involved" aria-labelledby="ways-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{ways.eyebrow}</p>
    <h2 id="ways-title" class="ways-title" data-reveal>{ways.title}</h2>
    <ul class="ways-list">
      {ways.items.map((w, i) => (
        <li class="way" data-reveal style={`--rd:${i * 120}`}>
          {photos[i] && (
            <div class="way-img">
              <img src={photos[i].src} alt={photos[i].alt} width={photos[i].width} height={photos[i].height} loading="lazy" decoding="async" />
            </div>
          )}
          <h3 class="way-title">{w.title}</h3>
          <p class="way-body">{w.body}</p>
          <a class="link way-link" href={`${CALENDLY}?a1=${encodeURIComponent(`About: ${w.title}`)}`} target="_blank" rel="noopener noreferrer">
            {ways.cta}<span class="sr-only"> about: {w.title} (opens Calendly in a new tab)</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      ))}
    </ul>

    {hasAbout && (
      <div class="about" data-reveal>
        <h3 class="about-title">{about.title}</h3>
        {about.body && <p class="about-body">{about.body}</p>}
        {about.people.length > 0 && (
          <ul class="people">
            {about.people.map((p) => <li><strong>{p.name}</strong>{p.role && <span>{p.role}</span>}</li>)}
          </ul>
        )}
        {about.email && <p><a class="link" href={`mailto:${about.email}`}>{about.email}</a></p>}
      </div>
    )}
  </div>
</section>

<style>
  .ways {
    position: relative;
    z-index: 2;
    background: var(--night-2);
    padding-block: clamp(6rem, 14vh, 10rem);
    border-top: 1px solid var(--line);
  }
  .ways-title { font-size: var(--t-h2); max-width: 14ch; }
  .ways-list {
    list-style: none;
    margin: clamp(3rem, 7vh, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .way { display: flex; flex-direction: column; gap: 0.9rem; border-top: 1px solid var(--line-2); padding-top: 1.4rem; }
  .way-img { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 5px; margin-bottom: 0.4rem; background: var(--night-3); }
  .way-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .way:hover .way-img img { transform: scale(1.04); }
  .way-title { font-size: var(--t-h3); font-weight: 380; letter-spacing: -0.015em; }
  .way-body { color: var(--text-2); max-width: 36ch; }
  .way-link { margin-top: auto; padding-top: 0.4rem; align-self: flex-start; }

  .about { margin-top: clamp(4rem, 9vh, 6rem); border-top: 1px solid var(--line-2); padding-top: 1.6rem; display: grid; gap: 0.8rem; max-width: 60ch; }
  .about-title { font-size: var(--t-h3); font-weight: 380; }
  .about-body { color: var(--text-2); }
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .people span { color: var(--text-2); margin-left: 0.6rem; }

  @media (max-width: 860px) {
    .ways-list { grid-template-columns: 1fr; }
  }
</style>
