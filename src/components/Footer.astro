---
import { content, CALENDLY } from '../data/content.js';
import { mediaCredits } from '../data/media.js';

const credits = mediaCredits();
const { newsletter, social, legal } = content;
const year = new Date().getFullYear();

// Simple monochrome icons, shown only for networks listed in content.social.
const ICONS = {
  linkedin: '<path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 .02 5 2.5 2.5 0 0 1-.02-5zM3 9.75h4v11H3zM9.5 9.75h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4z"/>',
  youtube: '<path fill="currentColor" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15.1V8.9l5.8 3.1z"/>',
  instagram: '<g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></g><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/>',
  x: '<path fill="currentColor" d="M17.8 3h3.3l-7.2 8.2L22.4 21h-6.6l-5.2-6.8L4.6 21H1.3l7.7-8.8L1 3h6.8l4.7 6.2zm-1.2 16h1.8L6.5 4.9H4.6z"/>',
  facebook: '<path fill="currentColor" d="M14 8.5V6.6c0-.9.6-1.1 1-1.1h2.7V1.6H14c-4.1 0-5 3-5 5v1.9H6.5v4H9V22h5v-9.5h3.4l.5-4z"/>',
};
const NAMES = { linkedin: 'LinkedIn', youtube: 'YouTube', instagram: 'Instagram', x: 'X', facebook: 'Facebook' };
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-top">
      <nav class="ftr-col" aria-label="Footer">
        <p class="ftr-head label">Explore</p>
        {content.nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="ftr-col">
        <p class="ftr-head label">The alliance</p>
        <a href={CALENDLY} target="_blank" rel="noopener noreferrer">Book a 30-minute call<span class="sr-only"> (opens Calendly in a new tab)</span></a>
        <a href="/old-growth">Old Growth</a>
        <a href="/index.md">This page as plain text</a>
      </div>
      <div class="ftr-brand">
        <img
          class="ftr-mark"
          src="/brand/mark-192.webp"
          srcset="/brand/mark-192.webp 192w, /brand/mark-320.webp 320w"
          sizes="88px"
          width="88"
          height="92"
          loading="lazy"
          decoding="async"
          alt=""
        />
        <p><strong>Liminal Forests <span>Alliance</span></strong></p>
      </div>
    </div>

    <div class="ftr-mid">
      <div class="signup">
        <h2 class="signup-title" id="signup-title">{newsletter.title}</h2>
        <form
          class="signup-form"
          method="post"
          action={newsletter.action || undefined}
          aria-labelledby="signup-title"
          data-signup
          data-not-open={newsletter.action ? undefined : newsletter.notOpen}
          data-success={newsletter.success}
          data-error={newsletter.error}
        >
          <label class="sr-only" for="signup-email">Email address</label>
          <input id="signup-email" type="email" name="email" autocomplete="email" required placeholder={newsletter.placeholder} />
          <button class="signup-btn" type="submit">{newsletter.button}</button>
        </form>
        <p class="signup-msg" role="status" aria-live="polite" data-signup-msg>
          {!newsletter.action && <span class="signup-soon">Mailing list opening soon.</span>}
        </p>
      </div>

      <div class="ftr-aside">
        {social.length > 0 && (
          <ul class="social">
            {social.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${NAMES[s.network] || s.network} (opens in a new tab)`}>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={ICONS[s.network] || ''} />
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="ftr-legal">
          <span>© {year} Liminal Forests Alliance</span>
          {legal.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="#top">Back to top</a>
        </p>
      </div>
    </div>

    <div class="ftr-fine">
      <p>{content.footerNote}</p>
      <p>
        {content.credits.satellite}
        {credits.length > 0 && (
          <Fragment>
            {' '}Film and photography:{' '}
            {credits.map((c, i) => (
              <Fragment>
                <a href={c.source} target="_blank" rel="noopener noreferrer">{c.credit}</a> ({c.licence}){i < credits.length - 1 ? ', ' : '.'}
              </Fragment>
            ))}
          </Fragment>
        )}
      </p>
    </div>
  </div>

  <p class="ftr-giant" aria-hidden="true">Liminal Forests</p>
</footer>

<style>
  .ftr {
    position: relative;
    z-index: 2;
    background: var(--night);
    border-top: 1px solid var(--line);
    padding-top: clamp(4rem, 9vh, 6rem);
    overflow: hidden;
  }

  /* ---------- link columns ---------- */
  .ftr-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .ftr-col { display: grid; gap: 0.85rem; align-content: start; justify-items: start; }
  .ftr-head { color: var(--text-3); margin-bottom: 0.3rem; }
  .ftr-col a {
    font-size: 1.12rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-1);
    transition: color 0.25s;
  }
  .ftr-col a:hover { color: var(--sun-soft); }
  .ftr-brand { display: grid; justify-items: end; gap: 1rem; text-align: right; }
  .ftr-mark { display: block; width: 88px; height: auto; }
  .ftr-brand p { display: grid; gap: 0.3rem; }
  .ftr-brand strong { font-family: var(--f-brand); font-weight: 720; font-size: 1.3rem; letter-spacing: -0.025em; }
  .ftr-brand strong span { font-weight: 420; opacity: 0.72; }

  /* ---------- sign-up + legal ---------- */
  .ftr-mid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.5rem;
    align-items: end;
    padding-top: clamp(2.5rem, 6vh, 4rem);
  }
  .signup { max-width: 34rem; }
  .signup-title {
    font-family: var(--f-body);
    font-size: clamp(1.3rem, 1.8vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin-bottom: 1.4rem;
  }
  .signup-form { display: flex; gap: 0.9rem; }
  .signup-form input {
    flex: 1;
    min-width: 0;
    min-height: 3.6rem;
    padding: 0 1.1rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--night-3);
    color: var(--text-1);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.25s, background-color 0.25s;
  }
  .signup-form input::placeholder { color: var(--text-2); }
  .signup-form input:focus { outline: none; border-color: var(--sun); background: #1c221e; }
  .signup-btn {
    min-height: 3.6rem;
    padding: 0 1.6rem;
    border-radius: 10px;
    border: 1.5px solid var(--sun);
    background: transparent;
    color: var(--sun-soft);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s;
  }
  .signup-btn:hover { background: var(--sun); color: var(--night); }
  .signup-msg { min-height: 1.6em; margin-top: 0.8rem; font-size: 0.9rem; color: var(--text-2); }
  .signup-msg a { color: var(--sun-soft); }

  .ftr-aside { display: grid; justify-items: end; gap: 1.6rem; }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.7rem; }
  .social a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--night-3);
    color: var(--text-1);
    transition: background-color 0.25s, color 0.25s;
  }
  .social a:hover { background: var(--bone); color: var(--night); }
  .ftr-legal { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.4rem 2rem; font-size: 0.86rem; color: var(--text-2); }
  .ftr-legal a { text-decoration: none; }
  .ftr-legal a:hover { color: var(--text-1); }

  .ftr-fine {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 2.5rem;
    margin-top: clamp(2.5rem, 6vh, 3.5rem);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-3);
  }
  .ftr-fine a { color: var(--text-2); }

  /* ---------- the giant name, fading into the dark ---------- */
  .ftr-giant {
    margin: clamp(2rem, 5vh, 3.5rem) 0 -0.16em;
    font-family: var(--f-brand);
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    font-size: 15.6vw;
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
    text-align: center;
    color: transparent;
    background: linear-gradient(180deg, #2c4a31 0%, #1a2b1e 48%, rgba(11, 13, 12, 0.2) 94%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .ftr-top { grid-template-columns: 1fr 1fr; }
    .ftr-brand { grid-column: 1 / -1; justify-items: start; text-align: left; grid-row: 1; }
    .ftr-mid { grid-template-columns: 1fr; align-items: start; }
    .ftr-aside { justify-items: start; }
    .ftr-legal { justify-content: flex-start; gap: 0.4rem 1.4rem; }
    .ftr-fine { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .signup-form { flex-direction: column; }
    .signup-btn { width: 100%; }
  }
</style>
