---
import { content } from '../data/content.js';
import { sceneImage, fmtDate } from '../lib/listings.js';

const { why } = content;
const words = why.title.split(' ');
const edge = sceneImage('scene-edge');
const edgeDate = edge ? fmtDate(edge.date) : '';
---

<section id="why" class="stakes" data-section="why">
  <div class="wrap stakes-head">
    <p class="eyebrow" data-reveal>{why.eyebrow}</p>
    <h2 class="stakes-title" data-scrub-words style={`--n:${words.length}`}>
      {words.map((w, i) => (
        <Fragment><span class:list={['sw', i >= words.length - 3 && 'sw-it']} style={`--i:${i}`}>{w}</span>{' '}</Fragment>
      ))}
    </h2>
  </div>

  {edge && (
    <div class="edge-track" data-edge>
      <figure class="edge-stage">
        <div class="edge-frame">
          <div class="edge-img">
            <img
              src={edge.src1600}
              srcset={`${edge.src800} 800w, ${edge.src1600} 1600w, /media/sat/scene-edge-3200.webp 3200w`}
              sizes="100vw"
              width="1600"
              height="1000"
              alt="Satellite view: dense, unbroken forest on the left meets a patchwork of cleared farm fields on the right."
              loading="lazy"
              decoding="async"
            />
            <div class="edge-dim" aria-hidden="true"></div>
            <img class="edge-line" src="/media/sat/scene-edge-line.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" aria-hidden="true" />
          </div>
        </div>
        <div class="edge-caps wrap" aria-live="off">
          <p class="cap cap-1">{why.scene.forest}</p>
          <p class="cap cap-2">{why.scene.lost}</p>
          <p class="cap cap-3">{why.scene.kept}</p>
        </div>
        <figcaption class="edge-source wrap">
          <span class="label">{why.scene.place}</span>
          <span>{why.scene.caption} Copernicus Sentinel-2, {edgeDate}.</span>
        </figcaption>
      </figure>
    </div>
  )}

  <div class="wrap stakes-body">
    <p class="stakes-lede" data-reveal>{why.lede}</p>
    <p class="stakes-para" data-reveal style="--rd:120">{why.para}</p>
  </div>

  <div class="wrap">
    <ol class="points">
      {why.points.map((pt, i) => (
        <li class="point" data-reveal style={`--rd:${i * 110}`}>
          <h3 class="point-title">{pt.strong.replace(/\.$/, '')}</h3>
          <p class="point-body">{pt.rest.trim()}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stakes {
    position: relative;
    z-index: 2;
    /* Overlap the end of the hero so the film dissolves into this chapter (no black gap). */
    margin-top: -42vh;
    padding-top: 42vh;
    background: linear-gradient(180deg, rgba(11, 13, 12, 0) 0, rgba(11, 13, 12, 0.88) 30vh, var(--night) 42vh);
  }
  :global(.static) .stakes { margin-top: 0; padding-top: clamp(5rem, 10vh, 8rem); background: var(--night); }

  .stakes-head { padding-bottom: clamp(1.5rem, 4vh, 3rem); }
  .stakes-title {
    --sp: 1;
    font-size: clamp(2.8rem, 6.6vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  :global(.js:not(.static)) .stakes-title { --sp: 0; }
  .sw { opacity: clamp(0.16, calc(var(--sp) * (var(--n) + 2) - var(--i)), 1); }
  .sw-it { font-style: italic; }

  /* ---------- the edge: a real satellite scene ---------- */
  .edge-track { position: relative; }
  :global(.js:not(.static)) .edge-track { height: 260vh; }
  .edge-stage {
    --ep: 1;
    margin: 0;
    position: relative;
    overflow: hidden;
    height: 100vh;
    height: 100svh;
    background: #0d110e;
  }
  :global(.js:not(.static)) .edge-stage { --ep: 0; position: sticky; top: 0; }
  :global(.static) .edge-stage, :global(html:not(.js)) .edge-stage { height: auto; overflow: visible; background: none; }
  :global(.static) .edge-stage::after, :global(html:not(.js)) .edge-stage::after { display: none; }
  :global(.static) .edge-frame, :global(html:not(.js)) .edge-frame { position: relative; width: 100%; height: min(90svh, 62.5vw); overflow: hidden; }

  .edge-frame { position: absolute; inset: 0; }
  .edge-img {
    --z: clamp(0, calc((var(--ep) - 0.18) / 0.36), 1);
    position: absolute;
    inset: 0;
    transform-origin: 4% 48%;
    transform: scale(calc(2 - var(--z)));
  }
  .edge-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .edge-dim {
    position: absolute;
    inset: 0;
    background: rgba(11, 13, 12, 0.8);
    -webkit-mask: url('/media/sat/scene-edge-cleared.webp') center / cover;
    mask: url('/media/sat/scene-edge-cleared.webp') center / cover;
    opacity: clamp(0, calc((var(--ep) - 0.6) / 0.18), 1);
  }
  .edge-line {
    opacity: clamp(0, calc((var(--ep) - 0.62) / 0.16), 1);
    clip-path: inset(0 calc((1 - clamp(0, (var(--ep) - 0.6) / 0.22, 1)) * 100%) 0 0);
    mix-blend-mode: screen;
  }
  .edge-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, var(--night) 0%, rgba(11, 13, 12, 0) 10%, rgba(11, 13, 12, 0) 62%, rgba(11, 13, 12, 0.88) 100%);
  }

  .edge-caps {
    position: absolute;
    inset: auto 0 clamp(5.5rem, 14vh, 8rem) 0;
    z-index: 2;
    min-height: 4.5rem;
  }
  .cap {
    position: absolute;
    bottom: 0;
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(2rem, 4.6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 18ch;
    text-shadow: 0 2px 30px rgba(11, 13, 12, 0.6);
  }
  .cap-1 { opacity: calc(clamp(0, (var(--ep) - 0.02) * 10, 1) - clamp(0, (var(--ep) - 0.24) * 10, 1)); }
  .cap-2 { opacity: calc(clamp(0, (var(--ep) - 0.32) * 10, 1) - clamp(0, (var(--ep) - 0.56) * 10, 1)); }
  .cap-3 { opacity: clamp(0, calc((var(--ep) - 0.66) * 8), 1); font-style: italic; color: var(--sun-soft); }
  :global(.static) .cap, :global(html:not(.js)) .cap { position: static; opacity: 1; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  :global(.static) .edge-caps, :global(html:not(.js)) .edge-caps { position: relative; inset: auto; padding-block: 1.6rem 0; display: grid; gap: 0.4rem; min-height: 0; }

  .edge-source {
    position: absolute;
    inset: auto 0 max(1.4rem, env(safe-area-inset-bottom)) 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    align-items: baseline;
    font-size: 0.86rem;
    color: var(--text-2);
  }
  .edge-source .label { color: var(--bone); }
  :global(.static) .edge-source, :global(html:not(.js)) .edge-source { position: relative; inset: auto; padding-block: 1rem 0; }

  /* ---------- text ---------- */
  .stakes-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-top: clamp(5rem, 12vh, 9rem);
  }
  .stakes-lede {
    font-family: var(--f-display);
    font-weight: 330;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .stakes-para { color: var(--text-2); max-width: 50ch; padding-top: 0.5rem; }

  .points {
    list-style: none;
    margin: clamp(4.5rem, 11vh, 8rem) 0 0;
    padding: 0 0 clamp(5rem, 12vh, 9rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .point { border-top: 1px solid var(--line-2); padding-top: 1.4rem; display: grid; gap: 0.7rem; align-content: start; }
  .point-title { font-size: var(--t-h3); font-weight: 380; letter-spacing: -0.015em; }
  .point-body { color: var(--text-2); max-width: 34ch; }

  @media (max-width: 860px) {
    .stakes-body { grid-template-columns: 1fr; }
    .points { grid-template-columns: 1fr; }
    .edge-img { transform-origin: 6% 48%; }
  }
</style>
