---
import { content, listings } from '../data/content.js';
import { media } from '../data/media.js';

const { hero } = content;
const film = media.hero;
// Every listing shown is on the market (the ones under review too).
const all = [...listings.for_sale, ...listings.new_candidates];
const totalHa = all.reduce((s, p) => s + p.size_ha, 0);
const fmt = (n) => n.toLocaleString('en-US');
let wi = 0;
---

<section id="top" class="hero" data-hero>
  <div class="hero-stage">
    <div class="hero-media" aria-hidden="true">
      {film && (
        <img
          class="hero-poster"
          src={film.poster || film.src}
          srcset={film.poster ? `/media/film/hero-poster-960.webp 960w, ${film.poster} 1920w` : undefined}
          sizes="100vw"
          alt=""
          width={film.width}
          height={film.height}
          fetchpriority="high"
          decoding="async"
        />
      )}
      {film?.video && (
        <video
          class="hero-video"
          muted
          loop
          playsinline
          preload="none"
          poster={film.poster}
          data-hd={film.video}
          data-sd={film.sd || film.video}
          data-film
        ></video>
      )}
    </div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="hero-copy wrap" data-hero-copy>
      <h1 class="hero-title">
        {hero.h1Lines.map((line, li) => (
          <span class:list={['hl', li === 1 && 'it']}>
            {line.split(' ').map((w) => (
              <Fragment><span class="w"><span style={`--i:${wi++}`}>{w}</span></span>{' '}</Fragment>
            ))}
          </span>
        ))}
      </h1>
      <p class="hero-lede">{hero.lede}</p>
      <div class="hero-actions">
        <a class="btn" href={hero.primaryCta.href} target="_blank" rel="noopener noreferrer">
          {hero.primaryCta.label}<span class="sr-only"> (opens Calendly in a new tab)</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="btn btn-ghost" href={hero.ghostCta.href}>{hero.ghostCta.label}</a>
      </div>
      <p class="hero-note">{hero.ctaNote}</p>
    </div>

    <p class="hero-hook">
      <span class="hk hk-lead">{hero.hook.lead}</span>
      <span class="hk hk-big"><em>{all.length}</em> {hero.hook.landscapes}</span>
      <span class="hk hk-mid">— {fmt(totalHa)} {hero.hook.hectares} —</span>
      <span class="hk hk-tail">{hero.hook.tail}</span>
      <span class="hk hk-after">{hero.hook.after}</span>
    </p>

    <div class="hero-foot wrap">
      {film?.video && (
        <button class="film-toggle" type="button" aria-pressed="false" data-film-toggle>
          <span class="film-icon" aria-hidden="true"><i></i><i></i></span>
          <span data-film-label>Pause film</span>
        </button>
      )}
      <span class="label hero-cue" aria-hidden="true">Scroll<i></i></span>
    </div>
  </div>
</section>

<style>
  .hero {
    --hp: 0;
    position: relative;
    background: var(--night);
  }
  :global(.js:not(.static)) .hero { height: 210vh; }

  .hero-stage {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    align-content: end;
  }
  :global(.js:not(.static)) .hero-stage { position: sticky; top: 0; height: 100vh; height: 100svh; }

  /* ---------- film ---------- */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(80% 60% at 60% 30%, #1f2a22, var(--night));
    transform: scale(calc(1.02 + var(--hp) * 0.12));
    transform-origin: 55% 45%;
  }
  .hero-poster, .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video { opacity: 0; transition: opacity 1.6s ease; }
  .hero-video.is-playing { opacity: 1; }
  :global(.js) .hero-poster { animation: film-in 2.2s ease both; }
  @keyframes film-in { from { opacity: 0; transform: scale(1.04); } }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(11, 13, 12, 0.55) 0%, rgba(11, 13, 12, 0) 22%),
      linear-gradient(90deg, rgba(11, 13, 12, 0.72) 0%, rgba(11, 13, 12, 0.3) 45%, rgba(11, 13, 12, 0) 70%),
      linear-gradient(0deg, rgba(11, 13, 12, 0.85) 0%, rgba(11, 13, 12, 0) 45%);
  }
  .hero-shade::after {
    /* Darkens the film as you scroll, but never to black. */
    content: '';
    position: absolute;
    inset: 0;
    background: var(--night);
    opacity: clamp(0, calc((var(--hp) - 0.05) * 1.1), 0.82);
  }

  /* ---------- copy ---------- */
  .hero-copy {
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(6.5rem, 15vh, 10rem);
    opacity: calc(1 - clamp(0, (var(--hp) - 0.06) / 0.16, 1));
    transform: translate3d(0, calc(clamp(0, (var(--hp) - 0.06) / 0.16, 1) * -70px), 0);
  }
  .hero-copy.is-gone { pointer-events: none; }
  .hero-foot.is-gone { visibility: hidden; }
  .hero-title {
    font-size: var(--t-hero);
    font-weight: 300;
    font-variation-settings: 'opsz' 72;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .hl { display: block; }
  .hl.it { font-style: italic; font-weight: 280; }
  .hero-title .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0 0.04em 0.12em 0;
    margin-bottom: -0.12em;
  }
  .hero-title .w > span { display: inline-block; }
  .hero-lede {
    margin-top: clamp(1.4rem, 3vh, 2rem);
    max-width: 52ch;
    font-size: var(--t-lede);
    line-height: 1.6;
    color: var(--text-1);
    text-shadow: 0 1px 24px rgba(11, 13, 12, 0.5);
  }
  .hero-actions { margin-top: clamp(1.6rem, 3.4vh, 2.2rem); display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero-note { margin-top: 1rem; font-size: 0.9rem; color: var(--text-2); max-width: 52ch; }

  :global(.js) .hero-title .w > span { animation: rise 1.4s var(--ease-out) backwards; animation-delay: calc(0.35s + var(--i) * 70ms); }
  :global(.js) .hero-lede,
  :global(.js) .hero-actions,
  :global(.js) .hero-note,
  :global(.js) .hero-foot { animation: fade-up 1.2s var(--ease-out) backwards; }
  :global(.js) .hero-lede { animation-delay: 0.85s; }
  :global(.js) .hero-actions { animation-delay: 1s; }
  :global(.js) .hero-note { animation-delay: 1.1s; }
  :global(.js) .hero-foot { animation-delay: 1.4s; }
  @keyframes rise { from { transform: translateY(108%); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(16px); } }

  /* ---------- the hook (appears as the film darkens) ---------- */
  .hero-hook {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding-inline: var(--gutter);
    pointer-events: none;
    background: radial-gradient(50% 42% at 50% 50%, rgba(11, 13, 12, 0.62), rgba(11, 13, 12, 0) 75%);
    opacity: calc(clamp(0, (var(--hp) - 0.2) * 8, 1) - clamp(0, (var(--hp) - 0.8) * 8, 1));
  }
  .hk {
    display: block;
    --in: clamp(0, calc((var(--hp) - var(--a)) * 9), 1);
    opacity: var(--in);
    transform: translate3d(0, calc((1 - var(--in)) * 26px), 0);
  }
  .hk-lead { --a: 0.22; font-family: var(--f-mono); font-size: var(--t-label); letter-spacing: 0.16em; text-transform: uppercase; color: var(--sun-soft); margin-bottom: 1.2rem; }
  .hk-big { --a: 0.25; font-family: var(--f-display); font-weight: 300; font-size: clamp(2.6rem, 6.6vw, 6.6rem); line-height: 0.98; letter-spacing: -0.025em; }
  .hk-big em { color: var(--sun-soft); }
  .hk-mid { --a: 0.3; font-family: var(--f-display); font-style: italic; font-weight: 300; font-size: clamp(1.5rem, 3vw, 2.6rem); margin-top: 0.3rem; }
  .hk-tail { --a: 0.33; font-family: var(--f-display); font-weight: 300; font-size: clamp(2.2rem, 5vw, 4.8rem); line-height: 1; letter-spacing: -0.02em; }
  .hk-after { --a: 0.42; margin-top: 1.4rem; color: var(--bone); font-size: clamp(1.02rem, 1.3vw, 1.18rem); }

  /* Calm layouts (reduced motion, no JS, very short screens): the hook is a plain line. */
  :global(.static) .hero-hook, :global(html:not(.js)) .hero-hook {
    display: block;
    position: relative;
    inset: auto;
    opacity: 1;
    background: none;
    padding: 0 var(--gutter) 5rem;
    justify-items: start;
    text-align: left;
    max-width: var(--maxw);
    margin-inline: auto;
    width: 100%;
  }
  :global(.static) .hk, :global(html:not(.js)) .hk { opacity: 1; transform: none; display: inline; font-size: var(--t-lede); font-family: var(--f-body); font-style: normal; color: var(--text-2); margin: 0; letter-spacing: 0; text-transform: none; }
  :global(.static) .hero-copy, :global(html:not(.js)) .hero-copy { padding-bottom: 2rem; }

  /* ---------- footer strip ---------- */
  .hero-foot {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: max(1.4rem, env(safe-area-inset-bottom));
    opacity: calc(1 - clamp(0, var(--hp) * 6, 1));
  }
  :global(.static) .hero-foot { position: relative; inset: auto; }
  .film-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    background: rgba(11, 13, 12, 0.45);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .film-toggle:hover { border-color: var(--bone); }
  /* Not shown on screen. The pause control only appears when someone reaches
     it with the keyboard, and screen readers still find it, so the looping
     film can always be stopped. Reduced-motion visitors get a still image. */
  .film-toggle:not(:focus-visible) {
    position: absolute;
    width: 1px;
    height: 1px;
    min-height: 0;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .film-icon { display: inline-flex; gap: 3px; }
  .film-icon i { width: 3px; height: 11px; background: currentColor; border-radius: 1px; }
  .film-toggle[aria-pressed='true'] .film-icon i:first-child { width: 0; height: 0; background: none; border-left: 9px solid currentColor; border-top: 5.5px solid transparent; border-bottom: 5.5px solid transparent; border-radius: 0; }
  .film-toggle[aria-pressed='true'] .film-icon i:last-child { display: none; }
  .hero-cue { display: inline-flex; align-items: center; gap: 0.8rem; color: var(--text-2); margin-left: auto; }
  .hero-cue i { position: relative; width: 1px; height: 36px; background: var(--line-2); overflow: hidden; }
  .hero-cue i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bone);
    transform: translateY(-100%);
    animation: cue 2.4s var(--ease-film) 2.2s 4;
  }
  @keyframes cue { 0% { transform: translateY(-100%); } 55% { transform: translateY(0); } 100% { transform: translateY(100%); } }

  @media (max-width: 700px) {
    .hero-copy { padding-bottom: 6rem; }
    .hero-title { font-size: clamp(2.6rem, 11.5vw, 3.8rem); }
    .hero-lede { font-size: 1rem; }
    .hero-shade {
      background:
        linear-gradient(180deg, rgba(11, 13, 12, 0.55) 0%, rgba(11, 13, 12, 0) 18%),
        linear-gradient(0deg, rgba(11, 13, 12, 0.95) 0%, rgba(11, 13, 12, 0.8) 45%, rgba(11, 13, 12, 0.5) 72%, rgba(11, 13, 12, 0.3) 100%);
    }
    .hero-cue { display: none; }
  }
</style>
